{
  "name": "dsh-interpreter",
  "version": "0.1.0",
  "description": "Adds a shorter, easier-to-read 「速览」 rewrite below every finished answer, and lets you choose the model that writes it.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "readability",
    "rewrite",
    "summary"
  ],
  "license": "MIT",
  "author": {
    "name": "Gaaaamu",
    "url": "https://github.com/Gaaaamu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaaaamu/dsh-interpreter.git"
  },
  "homepage": "https://github.com/Gaaaamu/dsh-interpreter#readme",
  "bugs": {
    "url": "https://github.com/Gaaaamu/dsh-interpreter/issues"
  },
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
